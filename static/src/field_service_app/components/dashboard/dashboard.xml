<?xml version="1.0" encoding="UTF-8" ?>
<template xml:space="preserve">
    <t t-name="field_service_pwa.dashboard">
        <div class="relative pt-[68px] h-screen">
            <div class="flex items-start">
                <!-- middle contents -->
                <section class="main-content w-full overflow-auto p-6">
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <t t-foreach="state.tasks" t-as="task" t-key='task.id'>
                            <div class="w-full h-48 rounded-lg border border-slate-300 bg-white p-4 shadow-sm font-sans text-slate-800">
                            
                                <h3 class="text-lg font-semibold text-slate-900 tracking-tight">
                                    <t t-esc='task.name'/>
                                </h3>

                                
                                <p class="mt-1 text-sm font-normal text-slate-500">
                                    <t t-if='task.partner_id'>
                                        <t t-esc='task.partner_id'/> <span class="mx-0.5">•</span> Fremont
                                    </t>
                                    
                                </p>
                                <t t-if='task.planned_date_begin and task.date_deadline'>
                                     <!-- Horário e Datas -->
                                    <div class="mt-3 flex items-center gap-2 text-sm font-medium text-slate-800">
                                        <span><t t-esc="this.formatTaskTimeRange(task.planned_date_begin, task.date_deadline).date"/>,<t t-esc="this.formatTaskTimeRange(task.planned_date_begin, task.date_deadline).startTime"/></span>
                                        <svg class="w-4 h-4 text-slate-700 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                        </svg>
                                        <span><t t-esc="this.formatTaskTimeRange(task.planned_date_begin, task.date_deadline).endTime"/></span>
                                    </div>
                                </t>
                               

                                <!-- Rodapé com Ícones e Avatares -->
                                <div class="mt-4 flex items-center justify-between pt-1">
                                    <!-- Ícones da esquerda (Relógio e Estrelas) -->
                                    <div class="flex items-center gap-3 text-slate-400">
                                    <!-- Ícone de Relógio -->
                                    <button class="hover:text-slate-600 transition-colors">
                                        <svg class="w-5 h-5 text-slate-600 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="9" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
                                        </svg>
                                    </button>

                                    <div class="flex items-center gap-1 text-slate-300">
                                        <t t-if="task.priority === '1'">
                                            <!-- Estrela 1: Preenchida (Amarela) -->
                                            <svg class="w-5 h-5 text-amber-400 fill-amber-400 stroke-[1.5]" stroke="currentColor" viewBox="0 0 24 24">
