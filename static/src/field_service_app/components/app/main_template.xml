<?xml version="1.0" encoding="UTF-8" ?>
<template xml:space="preserve">
    <t t-name="field_service_pwa.app">
         <t t-if='state.currentPath === "login"'>    
                 <Login userId="props.userId" onnavigate.bind="setPage"/>
            </t>
            <t t-if='state.currentPath === "dashboard"'>
                <Dashboard userId="state.userId" onnavigate.bind="setPage"/>
            </t>
    </t>
</template>